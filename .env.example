# Copy to .env (never commit .env). No real credentials belong in this file.
APP_ENV=development
# Local SQLite file (relative paths are resolved from where you start the backend; absolute is safest)
# DATABASE_URL=sqlite:///C:/path/to/evidencelens.db
# UPLOAD_DIR=C:/path/to/private/uploads
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Windows example if Tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
OCR_CONFIDENCE_THRESHOLD=80
APPROACHING_MATURITY_DAYS=30
ENABLE_DEMO_ENDPOINTS=true
# Login session length in hours
SESSION_HOURS=8

# ---- Deployment (hosted backend) ----
# Hosted Postgres instead of the local SQLite file (e.g. Neon). Both postgres:// and postgresql:// forms work.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Allow "Settings -> Load demo cases" on a deployed demo (off by default outside development)
# ALLOW_DEMO_IN_PRODUCTION=true
# Cookies: normally automatic. Only if the site and API are on different domains:
# COOKIE_SAMESITE=none
